{
  "rules": {
    "crossmateRooms": {
      ".indexOn": [
        "expiresAt"
      ],
      "$room": {
        ".read": "auth != null",
        ".write": "auth != null && ((!data.exists() && newData.child('players/p1/uid').val() === auth.uid) || data.child('players/p1/uid').val() === auth.uid || data.child('players/p2/uid').val() === auth.uid || (!data.child('players/p2').exists() && newData.child('players/p2/uid').val() === auth.uid))",
        ".validate": "newData.hasChildren(['players','state','expiresAt']) && newData.child('expiresAt').isNumber()"
      }
    },
    "crossmateNativeRooms": {
      ".indexOn": [
        "expiresAt"
      ],
      "$room": {
        ".read": "auth != null",
        ".write": "auth != null && newData.exists() && ((!data.exists() && newData.child('players/p1/uid').val() == auth.uid) || (data.exists() && (data.child('players/p1/uid').val() == auth.uid || data.child('players/p2/uid').val() == auth.uid || (!data.child('players/p2/uid').exists() && newData.child('players/p2/uid').val() == auth.uid))))",
        ".validate": "newData.hasChildren(['version', 'createdAt', 'expiresAt', 'players', 'state']) && newData.child('players/p1').hasChildren(['uid', 'joinedAt']) && (!data.child('players/p2').exists() || newData.child('players/p2').exists()) && (!newData.child('players/p2').exists() || (newData.child('players/p2').hasChildren(['uid', 'joinedAt']) && newData.child('players/p2/uid').val() != newData.child('players/p1/uid').val()))",
        "version": {
          ".validate": "newData.isString() && (!data.exists() || newData.val() == data.val())"
        },
        "createdAt": {
          ".validate": "newData.isNumber() && (!data.exists() || newData.val() == data.val())"
        },
        "expiresAt": {
          ".validate": "newData.isNumber() && (!data.exists() || newData.val() == data.val())"
        },
        "players": {
          "p1": {
            ".validate": "newData.hasChildren(['uid', 'joinedAt'])",
            "uid": {
              ".validate": "newData.isString() && (!data.exists() || newData.val() == data.val())"
            },
            "joinedAt": {
              ".validate": "newData.isNumber() && (!data.exists() || newData.val() == data.val())"
            },
            "$other": {
              ".validate": false
            }
          },
          "p2": {
            ".validate": "newData.hasChildren(['uid', 'joinedAt'])",
            "uid": {
              ".validate": "newData.isString() && ((!data.exists() && newData.val() == auth.uid) || (data.exists() && newData.val() == data.val()))"
            },
            "joinedAt": {
              ".validate": "newData.isNumber() && (!data.exists() || newData.val() == data.val())"
            },
            "$other": {
              ".validate": false
            }
          },
          "$other": {
            ".validate": false
          }
        },
        "state": {
          ".validate": "newData.hasChildren(['pieces', 'currentPlayer', 'scores', 'moveNumber'])"
        },
        "presence": {
          "$uid": {
            ".validate": "$uid == auth.uid && (newData.val() == true || !newData.exists())"
          }
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "lifeSandboxRooms": {
      ".indexOn": [
        "expiresAt"
      ],
      "$room": {
        ".read": "auth != null",
        "version": {
          ".write": "auth != null && root.child('lifeSandboxRooms').child($room).child('players/p1/uid').val() == auth.uid",
          ".validate": "newData.isString() && newData.val().length <= 20 && (!data.exists() || newData.val() == data.val())"
        },
        "createdAt": {
          ".write": "auth != null && root.child('lifeSandboxRooms').child($room).child('players/p1/uid').val() == auth.uid",
          ".validate": "newData.isNumber() && (!data.exists() || newData.val() == data.val())"
        },
        "expiresAt": {
          ".write": "auth != null && root.child('lifeSandboxRooms').child($room).child('players/p1/uid').val() == auth.uid",
          ".validate": "newData.isNumber() && newData.val() > now && newData.val() <= now + 950400000 && (!data.exists() || newData.val() == data.val())"
        },
        "players": {
          "p1": {
            ".write": "auth != null && ((!data.exists() && newData.exists() && newData.child('uid').val() == auth.uid) || (data.child('uid').val() == auth.uid && (!newData.exists() || newData.child('uid').val() == auth.uid)))",
            ".validate": "newData.hasChildren(['uid','joinedAt'])",
            "uid": {
              ".validate": "newData.isString() && newData.val() == auth.uid && (!data.exists() || newData.val() == data.val())"
            },
            "joinedAt": {
              ".validate": "newData.isNumber() && (!data.exists() || newData.val() == data.val())"
            },
            "$other": {
              ".validate": false
            }
          },
          "p2": {
            ".write": "auth != null && ((!data.exists() && newData.exists() && newData.child('uid').val() == auth.uid && newData.child('uid').val() != root.child('lifeSandboxRooms').child($room).child('players/p1/uid').val() && root.child('lifeSandboxRooms').child($room).child('expiresAt').val() >= now) || (data.child('uid').val() == auth.uid && (!newData.exists() || newData.child('uid').val() == auth.uid)))",
            ".validate": "newData.hasChildren(['uid','joinedAt']) && newData.child('uid').val() != root.child('lifeSandboxRooms').child($room).child('players/p1/uid').val()",
            "uid": {
              ".validate": "newData.isString() && newData.val() == auth.uid && (!data.exists() || newData.val() == data.val())"
            },
            "joinedAt": {
              ".validate": "newData.isNumber() && (!data.exists() || newData.val() == data.val())"
            },
            "$other": {
              ".validate": false
            }
          },
          "$other": {
            ".validate": false
          }
        },
        "presence": {
          "$uid": {
            ".write": "auth != null && $uid == auth.uid && (root.child('lifeSandboxRooms').child($room).child('players/p1/uid').val() == auth.uid || root.child('lifeSandboxRooms').child($room).child('players/p2/uid').val() == auth.uid) && (!newData.exists() || root.child('lifeSandboxRooms').child($room).child('expiresAt').val() >= now)",
            ".validate": "newData.val() == true"
          }
        },
        "live": {
          "$uid": {
            ".write": "auth != null && $uid == auth.uid && (root.child('lifeSandboxRooms').child($room).child('players/p1/uid').val() == auth.uid || root.child('lifeSandboxRooms').child($room).child('players/p2/uid').val() == auth.uid) && (!newData.exists() || root.child('lifeSandboxRooms').child($room).child('expiresAt').val() >= now)",
            ".validate": "newData.hasChildren(['x','y','scene','dirX','dirY','inVehicle','vehicleType','vehicleAngle','vehicleReverse','name','skin','shirt','pants','hair','hairStyle','accessory','emote','emoteUntil','action','actionUntil','pet','petFollowing','updatedAt'])",
            "x": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 3000"
            },
            "y": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 2200"
            },
            "scene": {
              ".validate": "newData.isString() && (newData.val() == 'town' || newData.val() == 'home' || newData.val() == 'cafe' || newData.val() == 'boutique' || newData.val() == 'petshop' || newData.val() == 'arcade')"
            },
            "dirX": {
              ".validate": "newData.isNumber() && newData.val() >= -1 && newData.val() <= 1"
            },
            "dirY": {
              ".validate": "newData.isNumber() && newData.val() >= -1 && newData.val() <= 1"
            },
            "inVehicle": {
              ".validate": "newData.isBoolean()"
            },
            "vehicleType": {
              ".validate": "newData.isString() && (newData.val() == 'car' || newData.val() == 'scooter' || newData.val() == 'bike' || newData.val() == 'roadster')"
            },
            "vehicleAngle": {
              ".validate": "newData.isNumber() && newData.val() >= -7 && newData.val() <= 7"
            },
            "vehicleReverse": {
              ".validate": "newData.isBoolean()"
            },
            "name": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 14"
            },
            "skin": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 5"
            },
            "shirt": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 7"
            },
            "pants": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 5"
            },
            "hair": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 5"
            },
            "hairStyle": {
              ".validate": "newData.isString() && (newData.val() == 'round' || newData.val() == 'spiky' || newData.val() == 'long' || newData.val() == 'bun')"
            },
            "accessory": {
              ".validate": "newData.isString() && (newData.val() == 'none' || newData.val() == 'cap' || newData.val() == 'glasses' || newData.val() == 'bow' || newData.val() == 'crown' || newData.val() == 'headphones')"
            },
            "emote": {
              ".validate": "newData.isString() && newData.val().length <= 12"
            },
            "emoteUntil": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 5000"
            },
            "action": {
              ".validate": "newData.isString() && newData.val().length <= 12"
            },
            "actionUntil": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 5000"
            },
            "pet": {
              ".validate": "newData.isString() && (newData.val() == 'none' || newData.val() == 'dog' || newData.val() == 'cat' || newData.val() == 'bunny')"
            },
            "petFollowing": {
              ".validate": "newData.isBoolean()"
            },
            "updatedAt": {
              ".validate": "newData.isNumber() && newData.val() > 0"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "world": {
          ".write": "auth != null && root.child('lifeSandboxRooms').child($room).child('players/p1/uid').val() == auth.uid && (!newData.exists() || root.child('lifeSandboxRooms').child($room).child('expiresAt').val() >= now)",
          ".validate": "newData.hasChildren(['minutes','weather','dayCycle','home','updatedAt'])",
          "minutes": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 1440"
          },
          "weather": {
            ".validate": "newData.isString() && (newData.val() == 'sunny' || newData.val() == 'cloudy' || newData.val() == 'rainy')"
          },
          "dayCycle": {
            ".validate": "newData.isBoolean()"
          },
          "home": {
            ".validate": "newData.hasChildren(['wall','floor','sofa','rug'])",
            "wall": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 5"
            },
            "floor": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 3"
            },
            "sofa": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 3"
            },
            "rug": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 3"
            },
            "$other": {
              ".validate": false
            }
          },
          "updatedAt": {
            ".validate": "newData.isNumber() && newData.val() > 0"
          },
          "$other": {
            ".validate": false
          }
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
